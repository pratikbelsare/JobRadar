# OpenAI-compatible chat provider (never commit a real API key)
JOB_INTELLIGENCE_CHAT_PROVIDER=openai_compatible
JOB_INTELLIGENCE_CHAT_MODEL=
JOB_INTELLIGENCE_CHAT_BASE_URL=
JOB_INTELLIGENCE_CHAT_API_KEY=
JOB_INTELLIGENCE_CHAT_MAX_TOKENS=4096
JOB_INTELLIGENCE_CHAT_TIMEOUT_SECONDS=60

# Local embeddings
JOB_INTELLIGENCE_EMBEDDING_PROVIDER=huggingface_local
JOB_INTELLIGENCE_LOCAL_EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
JOB_INTELLIGENCE_LOCAL_EMBEDDING_DEVICE=cpu
